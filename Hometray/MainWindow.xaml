<?xml version="1.0" encoding="utf-8"?>
<!-- Tray flyout: left click on the tray icon. No title bar. -->
<Window
    x:Class="Hometray.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Hometray"
    Title="Hometray">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" Padding="16,14,16,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- header: title + connection status, shortcuts -->
        <Grid x:Name="HeaderGrid" ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock FontSize="16"
                           FontWeight="SemiBold"
                           Text="Home Assistant" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Ellipse x:Name="StatusDot"
                             Width="8"
                             Height="8"
                             VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusText"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </StackPanel>

            <Button Grid.Column="1"
                    Padding="8"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OpenHa_Click"
                    ToolTipService.ToolTip="{local:Loc Key=menu.openHa}">
                <FontIcon FontSize="16" Glyph="&#xE774;" />
            </Button>
            <Button Grid.Column="2"
                    Padding="8"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="Settings_Click"
                    ToolTipService.ToolTip="{local:Loc Key=common.settings}">
                <FontIcon FontSize="16" Glyph="&#xE713;" />
            </Button>
        </Grid>

        <ScrollViewer x:Name="Scroller"
                      Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      VerticalScrollMode="Auto">
            <Grid x:Name="ContentHost" Margin="0,0,10,0">
                <!-- tiles (built in code) -->
                <Grid x:Name="TilesGrid" ColumnSpacing="8" RowSpacing="8" />

                <!-- nothing to show: not set up / no tiles -->
                <StackPanel x:Name="EmptyPanel"
                            Padding="0,32,0,16"
                            HorizontalAlignment="Center"
                            Spacing="8"
                            Visibility="Collapsed">
                    <FontIcon HorizontalAlignment="Center"
                              FontSize="32"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                              Glyph="&#xE80F;" />
                    <TextBlock x:Name="EmptyTitle"
                               HorizontalAlignment="Center"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="EmptyText"
                               MaxWidth="300"
                               HorizontalTextAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                    <Button HorizontalAlignment="Center"
                            Click="Settings_Click"
                            Content="{local:Loc Key=main.empty.button}"
                            Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- detail panel of a tile (long press): dimmed scrim + card at the bottom, inside the window -->
        <Grid x:Name="DetailOverlay"
              Grid.RowSpan="2"
              Margin="-16,-14,-16,-16"
              Visibility="Collapsed">
            <Rectangle Fill="#66000000" Tapped="DetailScrim_Tapped" />
            <ContentControl x:Name="DetailHost"
                            Margin="10"
                            HorizontalContentAlignment="Stretch"
                            IsTabStop="False"
                            VerticalAlignment="Bottom" />
        </Grid>

        <!-- result of an action that Home Assistant refused (on top of everything, closes itself) -->
        <InfoBar x:Name="ErrorBar"
                 Grid.Row="1"
                 VerticalAlignment="Top"
                 IsClosable="True"
                 IsOpen="False"
                 Severity="Error" />
    </Grid>
</Window>
