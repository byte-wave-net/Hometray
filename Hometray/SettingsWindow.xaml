<?xml version="1.0" encoding="utf-8"?>
<!-- Settings: right click on the tray icon → Einstellungen. -->
<Window
    x:Class="Hometray.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Hometray"
    Title="Hometray – Einstellungen">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- title bar -->
        <StackPanel x:Name="AppTitleBar"
                    Padding="12,0,0,0"
                    Orientation="Horizontal"
                    Spacing="8">
            <Image Width="16"
                   Height="16"
                   VerticalAlignment="Center"
                   Source="ms-appx:///Assets/appicon.png" />
            <TextBlock VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Text="{local:Loc Key=settings.title}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <StackPanel x:Name="ContentPanel" Padding="24,8,24,24" Spacing="12">

                <!-- ── Connection ─────────────────────────────────────────── -->
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{local:Loc Key=settings.section.connection}" />
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <TextBox x:Name="UrlBox"
                                 Header="{local:Loc Key=settings.url.header}"
                                 PlaceholderText="http://homeassistant.local:8123" />
                        <PasswordBox x:Name="TokenBox"
                                     Header="{local:Loc Key=settings.token.header}" />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   TextWrapping="Wrap"
                                   Text="{local:Loc Key=settings.token.hint}" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button x:Name="ConnectButton"
                                    Click="ConnectButton_Click"
                                    Content="{local:Loc Key=settings.connect}"
                                    Style="{StaticResource AccentButtonStyle}" />
                            <ProgressRing x:Name="BusyRing" Width="20" Height="20" IsActive="False" />
                        </StackPanel>
                        <InfoBar x:Name="StatusBar"
                                 IsClosable="False"
                                 IsOpen="True"
                                 Severity="Informational"
                                 Title="{local:Loc Key=settings.status.title}" />
                    </StackPanel>
                </Border>

                <!-- ── Tile picker ────────────────────────────────────────── -->
                <TextBlock Margin="0,8,0,0" Style="{StaticResource BodyStrongTextBlockStyle}" Text="{local:Loc Key=settings.section.add}" />
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <TextBox x:Name="SearchBox"
                                 PlaceholderText="{local:Loc Key=settings.search.placeholder}"
                                 TextChanged="SearchBox_TextChanged" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="DomainBox"
                                      HorizontalAlignment="Stretch"
                                      Header="{local:Loc Key=settings.filter.type}"
                                      SelectionChanged="Filter_SelectionChanged" />
                            <ComboBox x:Name="AreaBox"
                                      Grid.Column="1"
                                      HorizontalAlignment="Stretch"
                                      Header="{local:Loc Key=settings.filter.area}"
                                      SelectionChanged="Filter_SelectionChanged" />
                        </Grid>
                        <ListView x:Name="PickerList"
                                  Height="240"
                                  IsItemClickEnabled="False"
                                  SelectionMode="None" />
                        <TextBlock x:Name="PickerHint"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- ── Selected tiles ─────────────────────────────────────── -->
                <TextBlock Margin="0,8,0,0" Style="{StaticResource BodyStrongTextBlockStyle}" Text="{local:Loc Key=settings.section.tiles}" />
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   TextWrapping="Wrap"
                                   Text="{local:Loc Key=settings.tiles.hint}" />
                        <Button x:Name="AddGroupButton"
                                Click="AddGroupButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE8F4;" />
                                <TextBlock Text="{local:Loc Key=settings.addGroup}" />
                            </StackPanel>
                        </Button>
                        <ListView x:Name="SelectedList"
                                  MaxHeight="300"
                                  AllowDrop="True"
                                  CanDragItems="True"
                                  CanReorderItems="True"
                                  DragItemsCompleted="SelectedList_DragItemsCompleted"
                                  SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:SelectedTile">
                                    <Grid Padding="8,4" ColumnSpacing="12"
                                          Background="{x:Bind RowBrush}"
                                          CornerRadius="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon VerticalAlignment="Center"
                                                  FontSize="14"
                                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                  Glyph="{x:Bind Glyph}" />
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBox LostFocus="TileName_LostFocus"
                                                     PlaceholderText="{x:Bind Placeholder}"
                                                     Tag="{x:Bind}"
                                                     Text="{x:Bind Name, Mode=TwoWay}" />
                                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Text="{x:Bind Caption}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal"
                                                    Spacing="2">
                                            <Button Padding="8"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Click="MoveUp_Click"
                                                    Tag="{x:Bind}"
                                                    ToolTipService.ToolTip="{local:Loc Key=settings.tip.up}">
                                                <FontIcon FontSize="12" Glyph="&#xE70E;" />
                                            </Button>
                                            <Button Padding="8"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Click="MoveDown_Click"
                                                    Tag="{x:Bind}"
                                                    ToolTipService.ToolTip="{local:Loc Key=settings.tip.down}">
                                                <FontIcon FontSize="12" Glyph="&#xE70D;" />
                                            </Button>
                                            <Button Padding="8"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Click="RemoveTile_Click"
                                                    Tag="{x:Bind}"
                                                    ToolTipService.ToolTip="{local:Loc Key=settings.tip.remove}">
                                                <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock x:Name="NoTilesText"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="{local:Loc Key=settings.noTiles}"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <!-- ── Appearance / general ───────────────────────────────── -->
                <TextBlock Margin="0,8,0,0" Style="{StaticResource BodyStrongTextBlockStyle}" Text="{local:Loc Key=settings.section.general}" />
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="16">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{local:Loc Key=settings.language}" />
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Text="{local:Loc Key=settings.language.hint}" />
                            </StackPanel>
                            <ComboBox x:Name="LanguageBox"
                                      Grid.Column="1"
                                      MinWidth="200"
                                      SelectionChanged="LanguageBox_SelectionChanged" />
                        </Grid>
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{local:Loc Key=settings.columns}" />
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Text="{local:Loc Key=settings.columns.hint}" />
                            </StackPanel>
                            <ComboBox x:Name="ColumnsBox"
                                      Grid.Column="1"
                                      MinWidth="80"
                                      SelectionChanged="ColumnsBox_SelectionChanged" />
                        </Grid>
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{local:Loc Key=settings.confirm}" />
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           TextWrapping="Wrap"
                                           Text="{local:Loc Key=settings.confirm.hint}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="ConfirmToggle"
                                          Grid.Column="1"
                                          MinWidth="0"
                                          OffContent="{local:Loc Key=state.off}"
                                          OnContent="{local:Loc Key=state.on}"
                                          Toggled="ConfirmToggle_Toggled" />
                        </Grid>
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{local:Loc Key=settings.alwaysShow}" />
                                <TextBlock x:Name="AlwaysShowHint"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           TextWrapping="Wrap"
                                           Text="{local:Loc Key=settings.alwaysShow.hint}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="AlwaysShowToggle"
                                          Grid.Column="1"
                                          MinWidth="0"
                                          OffContent="{local:Loc Key=state.off}"
                                          OnContent="{local:Loc Key=state.on}"
                                          Toggled="AlwaysShowToggle_Toggled" />
                            <!-- Store (MSIX) version: Windows does not let the app pin its icon itself -->
                            <Button x:Name="AlwaysShowButton"
                                    Grid.Column="1"
                                    Click="AlwaysShowButton_Click"
                                    Content="{local:Loc Key=settings.taskbar.open}"
                                    Visibility="Collapsed" />
                        </Grid>
                        <CheckBox x:Name="AutostartCheckBox"
                                  Content="{local:Loc Key=settings.autostart}"
                                  Click="AutostartCheckBox_Click" />
                    </StackPanel>
                </Border>

                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           TextWrapping="Wrap"
                           Text="{local:Loc Key=settings.footer}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
