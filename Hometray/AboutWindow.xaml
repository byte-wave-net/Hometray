<?xml version="1.0" encoding="utf-8"?>
<!--
    About dialog (tray menu → About). Implements the Claude Design artboard
    "About Hometray" (dark, animated wave backdrop), without the title bar:
    720 × 396, dragged by the background, closed with "Close" or Esc.
-->
<Window
    x:Class="Hometray.AboutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Hometray"
    Title="About Hometray">

    <Grid x:Name="RootGrid" Background="#070B11" RequestedTheme="Dark"
          PointerPressed="RootGrid_PointerPressed">
        <Grid.Resources>
            <!-- accent from the design (#4DA8FF) -->
            <SolidColorBrush x:Key="AboutAccent" Color="#4DA8FF" />

            <!-- ── animations (started in code, off when Windows animations are off) ── -->
            <!-- wsDriftA 14s: translate(-110, -10), scaleY 1.14 -->
            <Storyboard x:Name="DriftA" RepeatBehavior="Forever" AutoReverse="True">
                <DoubleAnimation Storyboard.TargetName="WaveATransform" Storyboard.TargetProperty="TranslateX" From="0" To="-110" Duration="0:0:7">
                    <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="WaveATransform" Storyboard.TargetProperty="TranslateY" From="0" To="-10" Duration="0:0:7">
                    <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="WaveATransform" Storyboard.TargetProperty="ScaleY" From="1" To="1.14" Duration="0:0:7">
                    <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>

            <!-- wsDriftB 19s: mirrored, translate(-140, 12) in mirrored space, scaleY .9 → 1.05 -->
            <Storyboard x:Name="DriftB" RepeatBehavior="Forever" AutoReverse="True">
                <DoubleAnimation Storyboard.TargetName="WaveBTransform" Storyboard.TargetProperty="TranslateX" From="0" To="140" Duration="0:0:9.5">
                    <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="WaveBTransform" Storyboard.TargetProperty="TranslateY" From="0" To="12" Duration="0:0:9.5">
                    <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="WaveBTransform" Storyboard.TargetProperty="ScaleY" From="0.9" To="1.05" Duration="0:0:9.5">
                    <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>

            <!-- wsGlow 6s: opacity .55 ↔ .85 -->
            <Storyboard x:Name="Glow" RepeatBehavior="Forever" AutoReverse="True">
                <DoubleAnimation Storyboard.TargetName="WaveALayer" Storyboard.TargetProperty="Opacity" From="0.55" To="0.85" Duration="0:0:3">
                    <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>

            <!-- wsPulse: dash running along the curves (XAML dash units = stroke thickness) -->
            <Storyboard x:Name="PulseA" RepeatBehavior="Forever">
                <DoubleAnimation EnableDependentAnimation="True" Storyboard.TargetName="PulsePathA" Storyboard.TargetProperty="StrokeDashOffset" From="687.5" To="0" Duration="0:0:5" />
            </Storyboard>
            <Storyboard x:Name="PulseB" RepeatBehavior="Forever">
                <DoubleAnimation EnableDependentAnimation="True" Storyboard.TargetName="PulsePathB" Storyboard.TargetProperty="StrokeDashOffset" From="785.7" To="0" Duration="0:0:7" />
            </Storyboard>

            <!-- wsHalo 4s: opacity .35 ↔ .8, scale .92 ↔ 1.06 -->
            <Storyboard x:Name="Halo" RepeatBehavior="Forever" AutoReverse="True">
                <DoubleAnimation Storyboard.TargetName="HaloEllipse" Storyboard.TargetProperty="Opacity" From="0.35" To="0.8" Duration="0:0:2">
                    <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="HaloTransform" Storyboard.TargetProperty="ScaleX" From="0.92" To="1.06" Duration="0:0:2">
                    <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="HaloTransform" Storyboard.TargetProperty="ScaleY" From="0.92" To="1.06" Duration="0:0:2">
                    <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>

        </Grid.Resources>

        <!-- ── Wave backdrop (behind everything) ─────────────────────────── -->
        <!-- coordinates from the design (incl. 44 px title bar) → shifted up by 44 -->
        <Canvas Margin="0,-44,0,0" IsHitTestVisible="False">
            <Grid x:Name="WaveALayer" Canvas.Left="-200" Canvas.Top="70" Width="1120" Height="560" Opacity="0.7">
                <Image Source="ms-appx:///Assets/about-wave.png" Width="1120" Height="560" Stretch="Fill">
                    <Image.RenderTransform>
                        <CompositeTransform x:Name="WaveATransform" CenterX="560" CenterY="280" />
                    </Image.RenderTransform>
                </Image>
            </Grid>
            <Grid Canvas.Left="-250" Canvas.Top="100" Width="1220" Height="610" Opacity="0.3">
                <Image Source="ms-appx:///Assets/about-wave.png" Width="1220" Height="610" Stretch="Fill">
                    <Image.RenderTransform>
                        <CompositeTransform x:Name="WaveBTransform" CenterX="610" CenterY="305" ScaleX="-1" ScaleY="0.9" />
                    </Image.RenderTransform>
                </Image>
            </Grid>

            <!-- curves + running light pulses -->
            <Path Data="M-20 330 C 90 280, 180 280, 270 320 S 450 380, 540 330 S 680 285, 740 310"
                  Stroke="{StaticResource AboutAccent}" StrokeThickness="1" Opacity="0.18" />
            <Path x:Name="PulsePathA"
                  Data="M-20 330 C 90 280, 180 280, 270 320 S 450 380, 540 330 S 680 285, 740 310"
                  Stroke="#DDEFFF" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  StrokeDashCap="Round" StrokeDashArray="68.75 618.75" StrokeDashOffset="281.25" />
            <Path Data="M-20 370 C 100 400, 200 340, 300 360 S 480 420, 580 370 S 690 340, 740 360"
                  Stroke="{StaticResource AboutAccent}" StrokeThickness="1" Opacity="0.14" />
            <Path x:Name="PulsePathB"
                  Data="M-20 370 C 100 400, 200 340, 300 360 S 480 420, 580 370 S 690 340, 740 360"
                  Stroke="{StaticResource AboutAccent}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  StrokeDashCap="Round" StrokeDashArray="50 735.7" StrokeDashOffset="107.1" />

            <!-- vignette -->
            <Rectangle Width="720" Height="440">
                <Rectangle.Fill>
                    <RadialGradientBrush Center="0.5,0.78" GradientOrigin="0.5,0.78" RadiusX="0.71" RadiusY="1.1">
                        <GradientStop Offset="0" Color="#00070B11" />
                        <GradientStop Offset="0.65" Color="#80070B11" />
                        <GradientStop Offset="1" Color="#EB070B11" />
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Canvas>

        <!-- ── Content ───────────────────────────────────────────────────── -->
        <Grid Padding="48,44,48,28" RowSpacing="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="36">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="136" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- icon with pulsing halo -->
                <Grid Width="136" Height="136" VerticalAlignment="Center">
                    <Ellipse x:Name="HaloEllipse" Width="172" Height="172" Margin="-18" Opacity="0.35">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Offset="0" Color="#8C4DA8FF" />
                                <GradientStop Offset="0.7" Color="#004DA8FF" />
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                        <Ellipse.RenderTransform>
                            <CompositeTransform x:Name="HaloTransform" CenterX="86" CenterY="86" ScaleX="0.92" ScaleY="0.92" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Image Width="136" Height="136" Source="ms-appx:///Assets/appicon.png"
                           AutomationProperties.Name="Hometray app icon" />
                </Grid>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="18">
                    <StackPanel Spacing="6">
                        <TextBlock FontFamily="Segoe UI Variable Display" FontSize="34" FontWeight="Bold"
                                   CharacterSpacing="-12" LineHeight="44" Foreground="#E8EDF2" Text="Hometray" />
                        <TextBlock FontSize="16" LineHeight="24" Foreground="#B4C0CC" Text="{local:Loc Key=about.tagline}" />
                    </StackPanel>

                    <!-- info card -->
                    <Border Background="#CC0A1019" BorderBrush="#336EAAF0" BorderThickness="1" CornerRadius="10">
                        <StackPanel>
                            <Grid MinHeight="40" Padding="16,0" BorderBrush="#1F6EAAF0" BorderThickness="0,0,0,1">
                                <TextBlock VerticalAlignment="Center" FontSize="14" Foreground="#9FACBA" Text="{local:Loc Key=about.version}" />
                                <TextBlock x:Name="VersionText" HorizontalAlignment="Right" VerticalAlignment="Center"
                                           FontFamily="Cascadia Mono, Consolas" FontSize="14" Foreground="#E8EDF2" Text="1.0.0.0" />
                            </Grid>
                            <Grid MinHeight="40" Padding="16,0" BorderBrush="#1F6EAAF0" BorderThickness="0,0,0,1">
                                <TextBlock VerticalAlignment="Center" FontSize="14" Foreground="#9FACBA" Text="{local:Loc Key=about.developer}" />
                                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="14" Foreground="#E8EDF2" Text="Tobias Oberle" />
                            </Grid>
                            <Grid MinHeight="40" Padding="16,0">
                                <TextBlock VerticalAlignment="Center" FontSize="14" Foreground="#9FACBA" Text="{local:Loc Key=about.company}" />
                                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="14" Foreground="#E8EDF2" Text="Byte-Wave GmbH" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Close button (accent) -->
            <Button x:Name="CloseButton" Grid.Row="2" HorizontalAlignment="Right"
                    MinWidth="120" MinHeight="44" Padding="22,0" CornerRadius="6" BorderThickness="0"
                    FontSize="14" FontWeight="SemiBold" Content="{local:Loc Key=action.close}" Click="Close_Click">
                <Button.Resources>
                    <SolidColorBrush x:Key="ButtonBackground" Color="#4DA8FF" />
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#6BB8FF" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#3A95EA" />
                    <SolidColorBrush x:Key="ButtonForeground" Color="#03111F" />
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#03111F" />
                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#03111F" />
                </Button.Resources>
            </Button>
        </Grid>
    </Grid>
</Window>

